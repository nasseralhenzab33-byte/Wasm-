# وسم | WASM — متغيرات البيئة (انسخ إلى .env)
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# خلف Caddy/Nginx: اسمح بقراءة IP الحقيقي
TRUST_PROXY=1
DB_FILE=./data/wasm.db
UPLOAD_DIR=./data/uploads
LOG_REQUESTS=0

# الذكاء الاصطناعي (اختياري): none | anthropic | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# لواجهات متوافقة مع OpenAI (مثل مزود محلي أو إقليمي)
AI_BASE_URL=
